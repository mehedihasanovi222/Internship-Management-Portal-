# ==============================================================================
# INTERNSHIP MANAGEMENT PORTAL - ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your credentials when deploying to production
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Application Public URL (Update with your production domain)
VITE_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Optional: for direct Supabase cloud connectivity)
# Obtain these from: https://app.supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# GOOGLE OAUTH CONFIGURATION (For "Continue with Google")
# Obtain these from: https://console.cloud.google.com -> APIs & Services -> Credentials
# ------------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session & JWT Secret (Random 32-character string)
JWT_SECRET=super_secure_university_portal_jwt_secret_2026
